{
  "name": "@newmo/eslint-plugin-graphql-fake",
  "version": "1.0.0",
  "private": false,
  "description": "ESLint plugin for GraphQL fake",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "graphql",
    "fake",
    "testing",
    "mock"
  ],
  "repository": "https://github.com/newmo-oss/graphql-fake-server.git",
  "license": "MIT",
  "author": "newmo, Inc.",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      }
    }
  },
  "main": "./dist/esm/index.js",
  "files": [
    "src/",
    "!src/test",
    "!src/**/*.test.ts",
    "!src/**/__snapshots__",
    "dist/"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc",
    "test": "vitest run",
    "updateSnapshot": "vitest run -u"
  },
  "dependencies": {
    "@graphql-eslint/eslint-plugin": "catalog:"
  },
  "devDependencies": {
    "@tsconfig/node22": "catalog:",
    "@tsconfig/strictest": "catalog:",
    "@types/eslint": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "graphql": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vitest-github-actions-reporter": "catalog:"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0",
    "graphql": "^16.8.1"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
