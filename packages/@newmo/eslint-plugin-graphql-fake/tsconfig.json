{
  "extends": [
    "@tsconfig/strictest/tsconfig.json",
    "@tsconfig/node22/tsconfig.json"
  ],
  "compilerOptions": {
    "moduleResolution": "nodenext",
    "module": "NodeNext",
    "outDir": "dist/esm",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rootDirs": ["src"],
    "lib": ["ES2022"]
  },
  "include": ["src/**/*"]
}
