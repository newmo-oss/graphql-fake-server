{
    "extends": ["@tsconfig/strictest/tsconfig.json", "@tsconfig/node22/tsconfig.json"],
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "src/test",
        "src/**/*.test.ts",
        "src/**/__snapshots__"
    ],
    "compilerOptions": {
        "outDir": "dist",
        "rootDir": "src",
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        /* Lint Options */
        "noUnusedLocals": false, // Delegate to @typescript-eslint/no-unused-vars in eslint
        "noUnusedParameters": false // Delegate to @typescript-eslint/no-unused-vars in eslint
    }
}



