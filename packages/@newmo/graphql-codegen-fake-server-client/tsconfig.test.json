{
  "extends": [
    "@tsconfig/strictest/tsconfig.json",
    "@tsconfig/node22/tsconfig.json"
  ],
  "include": [
    "**/*"
  ],
  "compilerOptions": {
    "noEmit": true,
    "outDir": "dist",
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "lib": ["ES2022", "DOM"],
    /* Lint Options */
    "noUnusedLocals": false,
    // Delegate to @typescript-eslint/no-unused-vars in eslint
    "noUnusedParameters": false
    // Delegate to @typescript-eslint/no-unused-vars in eslint
  }
}



