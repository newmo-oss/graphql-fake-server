{
  "extends": [
    "@tsconfig/strictest/tsconfig.json",
    "@tsconfig/node18/tsconfig.json"
  ],
  "include": [
    "**/*"
  ],
  "compilerOptions": {
    "noEmit": true,
    "outDir": "dist",
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    /* Lint Options */
    "noUnusedLocals": false,
    // Delegate to @typescript-eslint/no-unused-vars in eslint
    "noUnusedParameters": false
    // Delegate to @typescript-eslint/no-unused-vars in eslint
  }
}



