{
  "name": "@newmo/graphql-codegen-fake-server-client",
  "version": "0.26.1",
  "private": false,
  "description": "GraphQL Codegen plugin for generating a fake server client",
  "keywords": [
    "testing",
    "mock",
    "graphql"
  ],
  "repository": "https://github.com/newmo-oss/graphql-fake-server.git",
  "license": "MIT",
  "author": "newmo, Inc.",
  "sideEffects": false,
  "type": "module",
  "main": "./dist/graphql-codegen-fake-server-client.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/graphql-codegen-fake-server-client.d.ts",
        "default": "./dist/graphql-codegen-fake-server-client.js"
      }
    }
  },
  "files": [
    "src/",
    "!src/test",
    "!src/**/*.test.ts",
    "!src/**/__snapshots__",
    "dist/"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc",
    "lint": "tsc --noEmit",
    "test": "npm run build && npm run codegen && npm run typecheck",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "codegen": "graphql-codegen --config graphql-codegen.ts",
    "updateSnapshot": "pnpm run codegen"
  },
  "dependencies": {
    "@graphql-codegen/plugin-helpers": "catalog:",
    "@graphql-codegen/visitor-plugin-common": "catalog:"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "catalog:",
    "@graphql-codegen/typescript": "catalog:",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@tsconfig/node22": "catalog:",
    "@tsconfig/strictest": "catalog:",
    "@types/eslint": "^9.6.1",
    "@types/node": "catalog:",
    "graphql": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "graphql": "^16.8.1"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
