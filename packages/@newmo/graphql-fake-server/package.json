{
  "name": "@newmo/graphql-fake-server",
  "description": "GraphQL fake server for testing",
  "version": "0.2.0",
  "type": "module",
  "sideEffects": false,
  "repository": "https://github.com/newmo-oss/graphql-fake-server.git",
  "author": "newmo, Inc.",
  "license": "MIT",
  "private": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      }
    },
    "./cli": {
      "import": {
        "types": "./dist/esm/cli.d.ts",
        "default": "./dist/esm/cli.js"
      }
    }
  },
  "workspaces": [
    "e2e/esm",
    "e2e/cjs",
    "e2e/browser"
  ],
  "scripts": {
    "build": "run-s -c build:*",
    "build:esm": "tsc -p tsconfig.build.json",
    "lint": "run-s -c lint:*",
    "lint:tsc": "tsc",
    "lint:biome": "npm exec @biomejs/biome check packages/ e2e/",
    "fix:biome": "npm exec @biomejs/biome check packages/ e2e/",
    "test": "vitest",
    "pree2e": "npm run build",
    "e2e": "npm -w e2e/esm -w e2e/cjs run start"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.7.1",
    "@graphql-codegen/cli": "^5.0.0",
    "@graphql-codegen/typescript": "^4.0.1",
    "@tsconfig/node18": "^18.2.0",
    "@tsconfig/strictest": "^2.0.1",
    "@types/eslint": "^8.44.2",
    "@types/node": "^20.5.1",
    "@vitest/browser": "^1.3.1",
    "biome": "^0.3.3",
    "eslint": "^8.47.0",
    "graphql": "^16.8.1",
    "npm-run-all": "^4.1.5",
    "tsx": "^4.7.1",
    "typescript": "^5.4.2",
    "vitest": "^1.3.1",
    "vitest-github-actions-reporter": "^0.11.1"
  },
  "overrides": {
    "tsconfig-paths": "^4.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "testing",
    "mock",
    "graphql",
    "graphql-code-generator"
  ],
  "files": [
    "src/",
    "!src/test",
    "!src/**/*.test.ts",
    "!src/**/__snapshots__",
    "dist/"
  ],
  "bin": {
    "@newmo/graphql-fake-server": "./dist/esm/cli.js"
  },
  "peerDependencies": {
    "graphql": "^16.0.0"
  },
  "dependencies": {
    "@apollo/server": "^4.10.4",
    "@graphql-codegen/plugin-helpers": "^5.0.1",
    "@graphql-codegen/visitor-plugin-common": "^4.0.1",
    "@graphql-tools/mock": "^9.0.2",
    "@graphql-tools/schema": "^10.0.3"
  }
}
