        ],
        "addLabels": [
          "dependencies",
          "dependencies/automerge"
        ],
        "automerge": true,
        "automergeType": "pr",
        "platformAutomerge": true
      },
      {
        "matchPackageNames": [
          "@hono/node-server",
          "@types/cors",
          "@types/express",
          "cors",
          "express",
          "hono",
          "undici"
        ],
        "groupName": "server automerge group",
        "groupSlug": "server-automerge",
        "matchUpdateTypes": [
          "minor",
          "patch"
        ],
        "addLabels": [
          "dependencies",
          "dependencies/automerge"
        ],
        "automerge": true,
        "automergeType": "pr",
        "platformAutomerge": true
      },
      {
        "matchPackageNames": [
          "@lerna-lite/cli",
          "@lerna-lite/publish",
          "@lerna-lite/version"
        ],
        "groupName": "lerna-lite automerge group",
        "groupSlug": "lerna-lite-automerge",
        "matchUpdateTypes": [
          "minor",
          "patch"
        ],
        "addLabels": [
          "dependencies",
          "dependencies/automerge"
        ],
        "automerge": true,
        "automergeType": "pr",
        "platformAutomerge": true
      },
      {
        "matchPackageNames": [
          "@tsconfig/node22",
          "@tsconfig/strictest",
          "@types/node",
          "typescript"
        ],
        "groupName": "typescript automerge group",
        "groupSlug": "typescript-automerge",
        "matchUpdateTypes": [
          "minor",
          "patch"
        ],
        "addLabels": [
          "dependencies",
          "dependencies/automerge"
        ],
        "automerge": true,
        "automergeType": "pr",
        "platformAutomerge": true
      },
      {
        "matchPackageNames": [
          "lint-staged"
        ],
        "groupName": "dev automerge group",
        "groupSlug": "dev-automerge",
        "matchUpdateTypes": [
          "minor",
          "patch"
        ],
        "addLabels": [
          "dependencies",
          "dependencies/automerge"
        ],
        "automerge": true,
        "automergeType": "pr",
        "platformAutomerge": true
      },
      {
        "matchPackageNames": [
          "vitest",
          "vitest-github-actions-reporter"
        ],
        "groupName": "test automerge group",
        "groupSlug": "test-automerge",
        "matchUpdateTypes": [
          "minor",
          "patch"
        ],
        "addLabels": [
          "dependencies",
          "dependencies/automerge"
        ],
        "automerge": true,
        "automergeType": "pr",
        "platformAutomerge": true
      }
    ]
  },
  // === </CATALOG> ===
}
