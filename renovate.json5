        ],
        "addLabels": [
          "dependencies",
          "dependencies/automerge"
        ],
        "automerge": true,
        "automergeType": "pr",
        "platformAutomerge": true
      },
      {
        "matchPackageNames": [
          "@graphql-codegen/cli",
