{
  "private": true,
  "name": "root",
  "version": "0.2.0",
  "description": "GraphQL fake server for testing",
  "keywords": [
    "testing",
    "mock",
    "graphql",
    "graphql-code-generator"
  ],
  "repository": "https://github.com/newmo-oss/graphql-fake-server.git",
  "license": "MIT",
  "author": "newmo, Inc.",
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "lint": "npm exec @biomejs/biome -- check packages/ e2e/",
    "lint:fix": "npm exec @biomejs/biome -- check --apply-unsafe packages/ e2e/",
    "format": "npm exec @biomejs/biome -- format --write packages/",
    "test": "pnpm -r run --if-present test",
    "updateSnapshot": "pnpm -r run updateSnapshot",
    "prepare": "git config --local core.hooksPath .githooks"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.7.1",
    "eslint": "^8.47.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@9.0.5",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,css}": [
      "npm exec @biomejs/biome -- format"
    ]
  }
}
