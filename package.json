{
  "private": true,
  "name": "root",
  "version": "0.2.0",
  "description": "GraphQL fake server for testing",
  "keywords": [
    "testing",
    "mock",
    "graphql",
    "graphql-code-generator"
  ],
  "repository": "https://github.com/newmo-oss/graphql-fake-server.git",
  "license": "MIT",
  "author": "newmo, Inc.",
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "lint": "pnpm run lint:biome && pnpm -r run --if-present lint",
    "lint:biome": "npm exec @biomejs/biome -- check packages/ e2e/",
    "lint:fix": "npm exec @biomejs/biome -- check --write --unsafe packages/ e2e/",
    "format": "npm exec @biomejs/biome -- format --write packages/ e2e/",
    "test": "pnpm -r run --if-present build && pnpm -r run --if-present test",
    "updateSnapshot": "pnpm run build && pnpm -r run updateSnapshot",
    "versionup": "lerna version",
    "ci:versionup:patch": "lerna version patch --no-push --no-git-tag-version --yes && npm run commit-version",
    "ci:versionup:minor": "lerna version minor --no-push --no-git-tag-version --yes && npm run commit-version",
    "ci:versionup:major": "lerna version major --no-push --no-git-tag-version --yes && npm run commit-version",
    "commit-version": "git add . && git commit -m \"chore(release): v`node -p 'require(\"./lerna.json\").version'`\"",
    "release": "lerna publish from-package",
    "ci:release": "lerna publish from-package --yes",
    "prepare": "git config --local core.hooksPath .githooks",
    "renovatebot:generate-config:run": "node script/renovatebot/generate-renovatebot-json5.ts",
    "renovatebot:generate-config:dry-run": "node script/renovatebot/generate-renovatebot-json5.ts --dry-run"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@lerna-lite/cli": "catalog:",
    "@lerna-lite/publish": "catalog:",
    "@lerna-lite/version": "catalog:",
    "lint-staged": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@11.1.3+sha512.c85357fe17ca12dd23dd7071822666dfd7e3cb76fe214e3370b5ea2fb34f2a231185509b63e717f3cd0acb38dd3f8d82bcd5e8172400ae678b70ea4fbed0896d",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,css}": "biome check --no-errors-on-unmatched --files-ignore-unknown=true"
  },
  "workspaces": [
    "packages/*"
  ]
}
