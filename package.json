{
  "private": true,
  "name": "root",
  "version": "0.2.0",
  "description": "GraphQL fake server for testing",
  "keywords": [
    "testing",
    "mock",
    "graphql",
    "graphql-code-generator"
  ],
  "repository": "https://github.com/newmo-oss/graphql-fake-server.git",
  "license": "MIT",
  "author": "newmo, Inc.",
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "lint": "npm exec @biomejs/biome check packages/ e2e/",
    "fix:biome": "npm exec @biomejs/biome check packages/ e2e/",
    "test": "pnpm -r run test",
    "updateSnapshot": "pnpm -r run updateSnapshot",
    "pree2e": "npm run build",
    "e2e": "pnpm run --filter ./e2e/node test"
  },
  "dependencies": {
  },
  "devDependencies": {
    "@biomejs/biome": "^1.7.1",
    "eslint": "^8.47.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@9.0.5"
}
