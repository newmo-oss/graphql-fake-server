{
    "private": true,
    "name": "e2e-browser",
    "version": "0.6.0",
    "type": "module",
    "scripts": {
        "start": "npm exec @newmo/graphql-fake-server -- --schema ./api/api.graphqls --logLevel=debug",
        "codgen": "graphql-codegen --config graphql-codegen.ts",
        "lint": "tsc",
        "test": "vitest --run"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "dependencies": {
        "@newmo/graphql-codegen-fake-server-client": "workspace:*",
        "@newmo/graphql-fake-server": "workspace:*"
    },
    "devDependencies": {
        "@graphql-codegen/cli": "^5.0.0",
        "@graphql-codegen/typescript": "^4.0.1",
        "@tsconfig/node18": "^18.2.0",
        "@tsconfig/strictest": "^2.0.1",
        "graphql-request": "^6.1.0",
        "vitest": "^1.3.1",
        "vitest-github-actions-reporter": "^0.11.1"
    }
}
