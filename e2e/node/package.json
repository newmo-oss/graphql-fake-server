{
    "private": true,
    "name": "e2e-node",
    "version": "0.18.1",
    "type": "module",
    "scripts": {
        "start": "npm exec @newmo/graphql-fake-server -- --config=./graphql-fake.config.mjs",
        "codegen": "graphql-codegen --config graphql-codegen.ts",
        "lint": "tsc",
        "test": "vitest run",
        "updateSnapshot": "vitest run -u"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "dependencies": {
        "@newmo/graphql-codegen-fake-server-client": "workspace:*",
        "@newmo/graphql-fake-server": "workspace:*"
    },
    "devDependencies": {
        "@apollo/client": "^3.12.11",
        "@graphql-codegen/cli": "^5.0.4",
        "@graphql-codegen/typescript": "^4.1.3",
        "@tsconfig/node18": "^18.2.0",
        "@tsconfig/strictest": "^2.0.1",
        "graphql-request": "^7.1.2",
        "vitest": "^3.0.5",
        "vitest-github-actions-reporter": "^0.11.1"
    }
}
